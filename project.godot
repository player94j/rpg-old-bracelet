; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited just fine.

config_version=5

[application]

config/name="Elden Baptist - Dark Fantasy RPG"
config/description="A 2D top-down open-world RPG inspired by Elden Ring. Play as John the Baptist, a mercenary with melee and magic combat styles."
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
EventManager="*res://scripts/autoload/event_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
LootTable="*res://scripts/autoload/loot_table.gd"
TutorialManager="*res://scripts/autoload/tutorial_manager.gd"
SkillManager="*res://scripts/autoload/skill_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

